{
  "name": "kalaido-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @kalaido/desktop dev",
    "dev:mobile": "pnpm --filter @kalaido/mobile dev",
    "dev:web": "pnpm --filter @kalaido/web dev",
    "dev:docs": "pnpm --filter @kalaido/docs dev",
    "build:desktop": "pnpm --filter @kalaido/desktop build",
    "build:mobile": "pnpm --filter @kalaido/mobile build",
    "build:web": "pnpm --filter @kalaido/web build",
    "build:docs": "pnpm --filter @kalaido/docs build",
    "typecheck": "pnpm -r typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:nav": "node scripts/check-navigation-discipline.mjs",
    "check:routes": "pnpm --filter @kalaido/desktop check:routes",
    "check:design": "node scripts/check-design-classes.mjs",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "pocketbase-typegen": "^1.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
