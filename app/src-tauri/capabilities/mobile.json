{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for the main window",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-text",
    "opener:default",
    "store:default"
  ]
}
